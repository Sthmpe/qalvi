# LiveKit Cloud (or self-hosted LiveKit server) credentials.
# Used only server-side, in src/app/api/livekit-token/route.ts — never
# exposed to the browser (AGENTS.md rule 15).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Optional real-interview multi-project routing. Apply the profile-routing
# migration and deploy a named Qalvi worker to EACH project before enabling.
# The demo token endpoint keeps using the legacy LIVEKIT_* values above.
# Once LIVEKIT_PROFILE_IDS is set, real interviews never fall back to legacy
# LIVEKIT_*; every enabled profile needs complete credentials and AGENT_NAME.
# Priorities must be unique. Omit LIVEKIT_PROFILE_IDS entirely for legacy mode.
# LIVEKIT_PROFILE_IDS=primary,backup_1
# LIVEKIT_ASSIGNMENT_TIMEOUT_MS=45000
# LIVEKIT_PROFILE_PRIMARY_URL=wss://primary-project.livekit.cloud
# LIVEKIT_PROFILE_PRIMARY_API_KEY=your_primary_api_key
# LIVEKIT_PROFILE_PRIMARY_API_SECRET=your_primary_api_secret
# LIVEKIT_PROFILE_PRIMARY_AGENT_NAME=qalvi-interview
# LIVEKIT_PROFILE_PRIMARY_PRIORITY=0
# LIVEKIT_PROFILE_PRIMARY_ENABLED=true
# LIVEKIT_PROFILE_BACKUP_1_URL=wss://backup-project.livekit.cloud
# LIVEKIT_PROFILE_BACKUP_1_API_KEY=your_backup_api_key
# LIVEKIT_PROFILE_BACKUP_1_API_SECRET=your_backup_api_secret
# LIVEKIT_PROFILE_BACKUP_1_AGENT_NAME=qalvi-interview
# LIVEKIT_PROFILE_BACKUP_1_PRIORITY=1
# LIVEKIT_PROFILE_BACKUP_1_ENABLED=true
# Optional on each profile: LIVEKIT_PROFILE_<ID>_DEPLOYMENT=production

# Supabase (M4). The URL and publishable key are public by design: row level
# security decides what they can reach, and anonymous access reaches nothing.
# The secret key bypasses row level security. It is server-only: never give it
# a NEXT_PUBLIC_ prefix, never log it, and never put it in participant code or
# the LiveKit agent (AGENTS.md rule 15). Stage 2B.2 invitation/session routes
# require this key on the Next.js server; do not put it in client environment.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key

# Stage 2B.4B scheduler hook for interview ejection retries. Server-only, at least
# 32 random characters. A scheduler (for example a cron every minute) calls
# POST /api/internal/lifecycle-outbox with "Authorization: Bearer <secret>".
# Without it, that route does not exist and ejection retries happen only when
# another request ends an interview.
# QALVI_INTERNAL_TASK_SECRET=replace_with_at_least_32_random_characters
