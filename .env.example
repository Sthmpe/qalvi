# LiveKit Cloud (or self-hosted LiveKit server) credentials.
# Used only server-side, in src/app/api/livekit-token/route.ts — never
# exposed to the browser (AGENTS.md rule 15).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Supabase (M4). The URL and publishable key are public by design: row level
# security decides what they can reach, and anonymous access reaches nothing.
# The secret key bypasses row level security. It is server-only: never give it
# a NEXT_PUBLIC_ prefix, never log it, and never put it in participant code or
# the LiveKit agent (AGENTS.md rule 15).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key
