# LiveKit Cloud (or self-hosted LiveKit server) credentials.
# Get these from https://cloud.livekit.io -> your project -> Settings -> Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Groq API key used for STT (Whisper), the interview LLM, and TTS.
# Get one from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# Real interviews only. Agent-side privileged database access; never browser-side.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_agent_key

# Optional: enable timing-only diagnostics on a development deployment.
# Automatically enabled for `python main.py dev` / `console`.
# QALVI_ENV=development
